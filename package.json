{
  "name": "electron-vue3-demo",
  "version": "1.0.0",
  "description": "Electron + Vue3 Application Framework",
  "main": "dist-electron/main.cjs",
  "author": "sumu126",
  "scripts": {
    "dev": "vite",
    "build": "node ./build.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "node scripts/install-hooks.mjs",
    "electron:dev": "npm run build && concurrently -k -n \"VITE,ELECTRON\" \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder --dir --publish never",
    "electron:build-win": "npm run build && electron-builder --win --config --publish never",
    "electron:start": "electron ."
  },
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "packageManager": "npm@10.9.8",
  "keywords": [
    "Electron",
    "Vue3",
    "Framework"
  ],
  "build": {
    "appId": "com.electron-vue3.demo",
    "productName": "electron-vue3-demo",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "package.json",
      "assets/**/*",
      "!node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/",
        "to": "dist/"
      }
    ],
    "publish": null,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.5.1",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^4.6.4"
  }
}
