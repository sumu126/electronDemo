{
  "name": "electron-vue3-demo",
  "version": "1.0.0",
  "description": "Electron + Vue3 Application Framework",
  "main": "dist-electron/main.cjs",
  "author": "sumu126",
  "scripts": {
    "dev": "vite",
    "build": "node ./build.mjs",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "electron:dev": "npm run build && concurrently -k -n \"VITE,ELECTRON\" \"npm run dev\" \"node scripts/delay-electron.js\"",
    "electron:build": "npm run build && electron-builder --dir",
    "electron:build-win": "npm run build && electron-builder --win --config",
    "electron:build-win-simple": "node build-app.js",
    "electron:start": "electron . --no-sandbox"
  },
  "keywords": [
    "Electron",
    "Vue3",
    "Framework"
  ],
  "build": {
    "appId": "com.electron-vue3.demo",
    "productName": "electron-vue3-demo",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json",
      "assets/**/*",
      ".env"
    ],
    "extraResources": [
      {
        "from": "dist/",
        "to": "dist/"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.ico",
      "publisherName": "Electron-Vue3 Team"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "concurrently": "^10.0.6",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "execa": "^10.2.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.14",
    "wait-on": "^9.5.1"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "dotenv": "^18.0.9",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  }
}
