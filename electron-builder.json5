{
  "appId": "com.electron-vue3.framework",
  "productName": "Electron Vue3 Framework",
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "asar": true,
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "target": ["dmg", "zip"]
  },
  "win": {
    "target": ["nsis"],
    "icon": "assets/icon.png"
  },
  "linux": {
    "target": ["AppImage"],
    "category": "Development"
  }
}